# Cole estas variáveis no serviço WORKER do Railway.
# Redis: adicione o plugin Redis no mesmo projeto — o Railway injeta REDIS_URL.
# Supabase: as MESMAS chaves do projeto que a Vercel usa (Settings → API).
# Deixe em branco até ter a conta; o worker sobe e espera.

REDIS_URL=
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
TOKEN_ENCRYPTION_KEY=

# Opcional — mesmo valor da Vercel
WHATSAPP_MAX_MSGS_PER_WINDOW=1
WHATSAPP_WINDOW_MS=2500
META_GRAPH_VERSION=v21.0
