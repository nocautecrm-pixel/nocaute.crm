# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
tsconfig.tsbuildinfo

# IDE
.cursor/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files
.env
.env*.local
!.env.example
!.env.railway.example

# vercel
.vercel

# criativos e logos enviados pelo lojista (demo local; produção usa Storage)
/public/uploads/criativos/*
!/public/uploads/criativos/.gitkeep
/public/uploads/logo/*
!/public/uploads/logo/.gitkeep

.vercel
.env*
