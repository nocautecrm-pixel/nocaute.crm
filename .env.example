# Copie para .env.local (Next na sua máquina) e preencha quando tiver as contas.
# Nunca commite .env / .env.local

# --- App (Vercel + local) ---
NEXT_PUBLIC_APP_URL=http://localhost:3001

# Demo local (cookie/KPI fake). Ignorado em NODE_ENV=production e VERCEL_ENV=production.
# Sem isso, o app vai para /indisponivel se o Supabase não estiver no ar.
ALLOW_DEMO=

# Auth: no Supabase → Authentication → URL Configuration
#   Site URL = NEXT_PUBLIC_APP_URL
#   Redirect URLs: {NEXT_PUBLIC_APP_URL}/auth/callback
# Confirmação de e-mail e “esqueci a senha” usam esse callback. Sem isso o lojista não entra.

# --- Supabase (obrigatório para dado real; o mesmo projeto nas 3 pontas) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Senha do Postgres (Database → Connection string → URI). Só local; npm run setup:db
SUPABASE_DB_URL=

# --- Meta Cloud API + Embedded Signup (Vercel) ---
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_EMBEDDED_SIGNUP_CONFIG_ID=
NEXT_PUBLIC_META_GRAPH_VERSION=v21.0
META_APP_ID=
META_APP_SECRET=
META_EMBEDDED_SIGNUP_CONFIG_ID=
META_GRAPH_VERSION=v21.0
WEBHOOK_VERIFY_TOKEN=
# Facebook Login for Business → Configurations → Create from template
#   → "WhatsApp Embedded Signup Configuration With 60 Expiration Token"
#   Cole o Configuration ID nos dois EMBEDDED_SIGNUP_CONFIG_ID (público + servidor).
# Sem isso o popup diz "este app precisa de uma supported permission".
# No app da Meta (WhatsApp → Configuration / callbacks):
#   Webhook:        {NEXT_PUBLIC_APP_URL}/api/webhooks/whatsapp
#   Deauth:         {NEXT_PUBLIC_APP_URL}/api/meta/deauth
#   Data deletion:  {NEXT_PUBLIC_APP_URL}/api/meta/data-deletion
# Templates: envie os JSON de public/templates/ na WABA da loja e espere APPROVED.

# --- Redis (local: docker compose up -d / Railway: plugin Redis) ---
REDIS_URL=redis://127.0.0.1:6379

# --- Segredos (32 bytes em hex = 64 chars). O MESMO TOKEN_ENCRYPTION_KEY na Vercel e no Railway. ---
COUPON_HMAC_SECRET=
TOKEN_ENCRYPTION_KEY=

# --- Throughput inicial ---
WHATSAPP_MAX_MSGS_PER_WINDOW=1
WHATSAPP_WINDOW_MS=2500

# --- Cron (Vercel) — anonimiza wamids/payloads após 30 dias ---
# Na Vercel, com CRON_SECRET definido, o cron envia Authorization: Bearer CRON_SECRET.
# Sem isso o endpoint recusa a chamada. REDIS_URL na Vercel também vale para o limite de cupom.
CRON_SECRET=
